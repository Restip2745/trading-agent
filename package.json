{
  "name": "trading-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Claude 自動交易系統：玉山證券 API + SQLite 影子帳本",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ctrade": "dist/cli/ctrade.js",
    "ctrade-admin": "dist/cli/ctrade-admin.js",
    "ctrade-daemon": "dist/daemon/main.js",
    "ctrade-web": "dist/web/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ctrade": "tsx cli/ctrade.ts",
    "ctrade-admin": "tsx cli/ctrade-admin.ts",
    "daemon": "tsx daemon/main.ts",
    "web": "tsx web/main.ts"
  },
  "dependencies": {
    "@esun/marketdata": "file:vendor/esun-marketdata-2.2.0.tgz",
    "@esun/trade": "file:vendor/esun-trade-2.2.0.tgz",
    "@fastify/static": "^10.1.6",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "fastify": "^5.12.7",
    "smol-toml": "^1.9.1",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
